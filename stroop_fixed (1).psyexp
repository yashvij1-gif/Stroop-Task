  <Flow>
    <Routine name="instructions"/>
    <LoopInitiator loopType="TrialHandler" name="practice">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('word', 'RED'), ('colour', 'red'), ('congruent', 'congruent'), ('corrAns', 'r')]), OrderedDict([('word', 'GREEN'), ('colour', 'green'), ('congruent', 'congruent'), ('corrAns', 'g')]), OrderedDict([('word', 'BLUE'), ('colour', 'blue'), ('congruent', 'congruent'), ('corrAns', 'b')]), OrderedDict([('word', 'YELLOW'), ('colour', 'yellow'), ('congruent', 'congruent'), ('corrAns', 'y')]), OrderedDict([('word', 'RED'), ('colour', 'blue'), ('congruent', 'incongruent'), ('corrAns', 'b')]), OrderedDict([('word', 'GREEN'), ('colour', 'yellow'), ('congruent', 'incongruent'), ('corrAns', 'y')]), OrderedDict([('word', 'BLUE'), ('colour', 'red'), ('congruent', 'incongruent'), ('corrAns', 'r')]), OrderedDict([('word', 'YELLOW'), ('colour', 'green'), ('congruent', 'incongruent'), ('corrAns', 'g')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="conditions.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="code"/>
      <Param name="name" updates="None" val="practice" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="fixation"/>
    <Routine name="trial"/>
    <Routine name="feedback"/>
    <Routine name="iti"/>
    <LoopTerminator name="practice"/>
    <Routine name="practice_over"/>
    <LoopInitiator loopType="TrialHandler" name="main">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('word', 'RED'), ('colour', 'red'), ('congruent', 'congruent'), ('corrAns', 'r')]), OrderedDict([('word', 'GREEN'), ('colour', 'green'), ('congruent', 'congruent'), ('corrAns', 'g')]), OrderedDict([('word', 'BLUE'), ('colour', 'blue'), ('congruent', 'congruent'), ('corrAns', 'b')]), OrderedDict([('word', 'YELLOW'), ('colour', 'yellow'), ('congruent', 'congruent'), ('corrAns', 'y')]), OrderedDict([('word', 'RED'), ('colour', 'blue'), ('congruent', 'incongruent'), ('corrAns', 'b')]), OrderedDict([('word', 'GREEN'), ('colour', 'yellow'), ('congruent', 'incongruent'), ('corrAns', 'y')]), OrderedDict([('word', 'BLUE'), ('colour', 'red'), ('congruent', 'incongruent'), ('corrAns', 'r')]), OrderedDict([('word', 'YELLOW'), ('colour', 'green'), ('congruent', 'incongruent'), ('corrAns', 'g')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="conditions.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="10" valType="code"/>
      <Param name="name" updates="None" val="main" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="fixation"/>
    <Routine name="trial"/>
    <Routine name="iti"/>
    <LoopInitiator loopType="TrialHandler" name="break_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="$1 if main.thisN == 39 else 0" valType="code"/>
      <Param name="name" updates="None" val="break_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="break_screen"/>
    <LoopTerminator name="break_loop"/>
    <LoopTerminator name="main"/>
    <Routine name="end"/>
  </Flow>
</PsychoPy2experiment>
