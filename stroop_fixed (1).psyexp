        <Param val="ink = {'red': '#ff0000', 'green': '#00cc00', 'blue': '#3366ff', 'yellow': '#ffff00'}[colour]&amp;#10;word_text.bold = True" valType="extendedCode" updates="constant" name="Begin Routine"/>
